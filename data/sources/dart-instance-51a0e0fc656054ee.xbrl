  <ifrs-full:TradeReceivables contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="-3">1987718638000</ifrs-full:TradeReceivables>
