  <dart:LitigationAmount contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_ClassesofLegalProceedingsContingentLiabilityAxis_dart_DefendantInLawsuitsMember" unitRef="KRW" decimals="-6">1423075000000</dart:LitigationAmount>
