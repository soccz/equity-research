  <dart:DescriptionOfCommitments contextRef="PFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00401731_LoanCommitments3OfLoanCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">연결회사는 신한은행 등과 기업어음약정 40,000백만원을 체결하고 있습니다.</dart:DescriptionOfCommitments>
  <dart:DescriptionOfCommitments contextRef="PFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00401731_LoanCommitments1OfLoanCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">연결회사는 신한은행 등 다수의 금융기관과 8,354,071백만원을 한도로 당좌차월약정 및 무역금융 등의 대출약정을 맺고 있습니다.</dart:DescriptionOfCommitments>
  <ifrs-full:PropertyPlantAndEquipment contextRef="PFY2024eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_PropertyPlantAndEquipmentByOperatingLeaseStatusAxis_ifrs-full_PropertyPlantAndEquipmentSubjectToOperatingLeasesMember_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_ifrs-full_AccumulatedDepreciationAndAmortisationMember" unitRef="KRW" decimals="-6">-282595000000</ifrs-full:PropertyPlantAndEquipment>
