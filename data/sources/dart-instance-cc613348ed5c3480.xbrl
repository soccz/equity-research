  <ifrs-full:ImpairmentLossRecognisedInProfitOrLossIntangibleAssetsAndGoodwill contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_IndividualAssetsOrCashgeneratingUnitsAxis_ifrs-full_IndividualAssetsOrCashgeneratingUnitsMember_ifrs-full_SegmentsAxis_entity00401731_SomeBusinessDivisionsOfLgInnotekCoLtdOfReportableSegmentsMemberOfDisclosureOfImpairmentLossAndReversalOfImpairmentLossIntangibleAssetsTableOfMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_IntangibleAssetsAndGoodwillMember" unitRef="KRW" decimals="-6">11909000000</ifrs-full:ImpairmentLossRecognisedInProfitOrLossIntangibleAssetsAndGoodwill>
