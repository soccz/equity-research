  <dart:NameOfTheInstitutionMakingTheCommitments contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_dart_TypesOfCommitmentsAxis_entity00155319_SuccessfulLoanForeignCurrencyLongTermBorrowingAgreementPoscoHoldingsCoLtdOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">한국에너지공단</dart:NameOfTheInstitutionMakingTheCommitments>
