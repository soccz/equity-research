  <dart:DecreaseOfRightofuseAssetsDueToTerminationOrCancellationOfLeaseContracts contextRef="PFY2025dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_LandMember" unitRef="KRW" decimals="-3">0</dart:DecreaseOfRightofuseAssetsDueToTerminationOrCancellationOfLeaseContracts>
  <dart:DecreaseOfRightofuseAssetsDueToTerminationOrCancellationOfLeaseContracts contextRef="PFY2025dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_VehiclesMember" unitRef="KRW" decimals="-3">159641000</dart:DecreaseOfRightofuseAssetsDueToTerminationOrCancellationOfLeaseContracts>
  <dart:DecreaseOfRightofuseAssetsDueToTerminationOrCancellationOfLeaseContracts contextRef="PFY2025dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember" unitRef="KRW" decimals="-3">159641000</dart:DecreaseOfRightofuseAssetsDueToTerminationOrCancellationOfLeaseContracts>
