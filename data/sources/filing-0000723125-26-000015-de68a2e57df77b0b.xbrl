        <link:footnote id="fn-1" xlink:label="fn-1" xlink:role="http://www.xbrl.org/2003/role/footnote" xlink:type="resource" xml:lang="en-US"><xhtml:span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%;padding-left:5.57pt">The maturities of long-term marketable investments primarily range from</xhtml:span><xhtml:span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"> </xhtml:span><xhtml:span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"><xhtml:span style="-sec-ix-hidden:f-465">one</xhtml:span> to</xhtml:span><xhtml:span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"> </xhtml:span><xhtml:span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%">five years, except for asset-backed securities which are not due at a single maturity date.</xhtml:span></link:footnote>
