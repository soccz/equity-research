    <goog:LossContingencyLossInPeriodAdjustment contextRef="c-356" decimals="-6" id="f-1311" unitRef="usd">217000000</goog:LossContingencyLossInPeriodAdjustment>
    <us-gaap:LossContingencyLossInPeriod contextRef="c-357" decimals="-8" id="f-1312" unitRef="eur">1500000000</us-gaap:LossContingencyLossInPeriod>
    <us-gaap:LossContingencyLossInPeriod contextRef="c-358" decimals="-8" id="f-1313" unitRef="usd">1700000000</us-gaap:LossContingencyLossInPeriod>
