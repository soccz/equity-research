  <entity00828497:ContractSubjectOfDisclosureOfTechnologyTransferAgreementCommitmentsLineItemsOfDisclosureOfTechnologyTransferAgreementCommitmentsTableOfItems contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00828497_TechnologyTransferArrangementMemberOfTypesOfCommitmentsMemberOfDisclosureOfTechnologyTransferAgreementCommitmentsTableOfMember_ifrs-full_CounterpartiesAxis_entity00828497_AptoseBiosciencesIncMemberOfCounterpartiesMemberOfDisclosureOfTechnologyTransferAgreementCommitmentsTableOfMember" xml:lang="ko">급성골수성백혈병(AML) 치료제 'HM43239' 물질</entity00828497:ContractSubjectOfDisclosureOfTechnologyTransferAgreementCommitmentsLineItemsOfDisclosureOfTechnologyTransferAgreementCommitmentsTableOfItems>
