  <entity00828497:RangeOfPaymentDueDatesForBothTheFinancialLiabilitiesThatArePartOfASupplierFinanceArrangementOfDisclosureOfSupplierFinanceArrangementsLineItemsOfDisclosureOfSupplierFinanceArrangementsTableOfItems contextRef="PFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00828497_SupplierFinanceArrangementsMemberOfTypesOfCommitmentsMemberOfDisclosureOfSupplierFinanceArrangementsTableOfMember_ifrs-full_RangeAxis_ifrs-full_TopOfRangeMember" xml:lang="ko">90일</entity00828497:RangeOfPaymentDueDatesForBothTheFinancialLiabilitiesThatArePartOfASupplierFinanceArrangementOfDisclosureOfSupplierFinanceArrangementsLineItemsOfDisclosureOfSupplierFinanceArrangementsTableOfItems>
