  <ifrs-full:LongtermBorrowings contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_ClassesOfLiabilitiesAxis_ifrs-full_LongtermBorrowingsMember_ifrs-full_MeasurementAxis_ifrs-full_AtCostMember_ifrs-full_ValuationTechniquesUsedInFairValueMeasurementAxis_ifrs-full_DiscountedCashFlowMember" unitRef="KRW" decimals="-6">1353620000000</ifrs-full:LongtermBorrowings>
  <dart:NoncurrentNontradeReceivables contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_ClassesOfAssetsAxis_dart_OtherReceivablesMember_ifrs-full_MeasurementAxis_ifrs-full_NotMeasuredAtFairValueInStatementOfFinancialPositionButForWhichFairValueIsDisclosedMember_ifrs-full_ValuationTechniquesUsedInFairValueMeasurementAxis_ifrs-full_DiscountedCashFlowMember" unitRef="KRW" decimals="-6">175791000000</dart:NoncurrentNontradeReceivables>
  <dart:NoncurrentNontradeReceivables contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_ClassesOfAssetsAxis_dart_OtherReceivablesMember_ifrs-full_MeasurementAxis_ifrs-full_AtCostMember_ifrs-full_ValuationTechniquesUsedInFairValueMeasurementAxis_ifrs-full_DiscountedCashFlowMember" unitRef="KRW" decimals="-6">183039000000</dart:NoncurrentNontradeReceivables>
  <entity00105961:DisclosureOfSignificantUnobservableInputsUsedInFairValueMeasurementOfAssetsTextBlock contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember" xml:lang="ko">만약, 하나 이상의 유의적인 투입변수가 관측가능한 시장정보에 기초한 것이 아니라면 해당 상품은 '수준 3'에 포함됩니다.

보고기간말 현재 공정가치로 측정되는 자산과 부채 중 공정가치 서열체계에 '수준3'으로 분류된 자산과 부채는 시장성 없는 금융상품 및 내재파생상품으로 구성되어 있으며, 할인율 등을 투입변수로 고려하여 현금흐름할인기법 및 이항모형 등으로 측정하고 있습니다.</entity00105961:DisclosureOfSignificantUnobservableInputsUsedInFairValueMeasurementOfAssetsTextBlock>
  <ifrs-full:DescriptionOfInputsUsedInFairValueMeasurementLiabilities contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_LevelsOfFairValueHierarchyAxis_ifrs-full_Level2OfFairValueHierarchyMember" xml:lang="ko">할인율</ifrs-full:DescriptionOfInputsUsedInFairValueMeasurementLiabilities>
  <ifrs-full:DescriptionOfValuationTechniquesUsedInFairValueMeasurementLiabilities contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_LevelsOfFairValueHierarchyAxis_ifrs-full_Level2OfFairValueHierarchyMember" xml:lang="ko">현금흐름 할인모형</ifrs-full:DescriptionOfValuationTechniquesUsedInFairValueMeasurementLiabilities>
  <ifrs-full:HedgingInstrumentLiabilities contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_LevelsOfFairValueHierarchyAxis_ifrs-full_Level2OfFairValueHierarchyMember" unitRef="KRW" decimals="-6">1826000000</ifrs-full:HedgingInstrumentLiabilities>
  <ifrs-full:DescriptionOfInputsUsedInFairValueMeasurementAssets contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_LevelsOfFairValueHierarchyAxis_ifrs-full_Level2OfFairValueHierarchyMember" xml:lang="ko">할인율 및 환율</ifrs-full:DescriptionOfInputsUsedInFairValueMeasurementAssets>
  <ifrs-full:DescriptionOfValuationTechniquesUsedInFairValueMeasurementAssets contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_LevelsOfFairValueHierarchyAxis_ifrs-full_Level2OfFairValueHierarchyMember" xml:lang="ko">현금흐름 할인모형</ifrs-full:DescriptionOfValuationTechniquesUsedInFairValueMeasurementAssets>
  <ifrs-full:HedgingInstrumentAssets contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_LevelsOfFairValueHierarchyAxis_ifrs-full_Level2OfFairValueHierarchyMember" unitRef="KRW" decimals="-6">14793000000</ifrs-full:HedgingInstrumentAssets>
  <entity00105961:DisclosureOfLevel2OfFairValueHierarchyTextBlock contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember" xml:lang="ko">활성시장에서 거래되는 금융상품의 공정가치는 보고기간 말 현재 고시되는 시장가격에 기초하여 산정됩니다. 거래소, 판매자, 중개인, 산업집단, 평가기관 또는 감독기관을 통해 공시가격이 용이하게 정기적으로 이용가능하고, 그러한 가격이 독립된 당사자 사이에서 정기적으로 발생한 실제 시장거래를 나타낸다면, 이를 활성시장으로 간주합니다.

활성시장에서 거래되지 아니하는 금융상품의 공정가치에 대하여 평가기법을 사용하여 결정하고 있습니다. 당사는 다양한 평가기법을 활용하고 있으며 보고기간말 현재 시장 상황에 근거하여 가정을 수립하고 있습니다. 이러한 평가기법은 가능한 한 관측가능한 시장정보를 최대한 사용하고 기업특유정보를 최소한으로 사용합니다. 이때, 해당상품의 공정가치 측정에 요구되는 모든 유의적인 투입변수가 관측가능하다면 해당상품은 '수준 2'에 포함됩니다. '수준 2'로 분류되는 금융상품은 파생상품입니다.</entity00105961:DisclosureOfLevel2OfFairValueHierarchyTextBlock>
