    <us-gaap:ProductWarrantyAccrualPreexistingIncreaseDecrease contextRef="c-18" decimals="-6" id="f-1745" unitRef="usd">1586000000</us-gaap:ProductWarrantyAccrualPreexistingIncreaseDecrease>
