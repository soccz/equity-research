  <dart:DiscountOnBondsIssued contextRef="CFY2026eFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_dart_ReportedAmountMember" unitRef="KRW" decimals="-3">1132481000</dart:DiscountOnBondsIssued>
  <entity00266961:DisclosureOfRevenueAndExpenseRelatedToInvestmentPropertyTextBlock contextRef="CFY2026dFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember" xml:lang="ko">나. 당분기 및 전분기 중 투자부동산과 관련한 수익의 내역은 다음과 같습니다.</entity00266961:DisclosureOfRevenueAndExpenseRelatedToInvestmentPropertyTextBlock>
  <entity00266961:OtherLiabilitiesRelatedPartyTransactionsOfDisclosureOfOutstandingBalancesOfReceivablesDueFromAndPayablesDueToRelatedPartiesLineItemsOfDisclosureOfOutstandingBalancesOfReceivablesDueFromAndPayablesDueToRelatedPartiesTableOfItems contextRef="CFY2026dFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_CategoriesOfRelatedPartiesAxis_entity00266961_NamooActorsCorpOfAssociatesMemberOfDisclosureOfOutstandingBalancesOfReceivablesDueFromAndPayablesDueToRelatedPartiesTableOfMember" unitRef="KRW" decimals="-3">0</entity00266961:OtherLiabilitiesRelatedPartyTransactionsOfDisclosureOfOutstandingBalancesOfReceivablesDueFromAndPayablesDueToRelatedPartiesLineItemsOfDisclosureOfOutstandingBalancesOfReceivablesDueFromAndPayablesDueToRelatedPartiesTableOfItems>
