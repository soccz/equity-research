    <ecd:MtrlTermsOfTrdArrTextBlock contextRef="c-369" id="f-1123">&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:7.3pt"&gt;Jacqueline Canney, our Chief People and AI Enablement Officer, adopted a trading plan on May 29, 2026. The plan, which expires May 19, 2027, provides for the sale of (i) up to $500,000 of shares of our common stock and (ii) 100% of the net shares resulting from the vesting of 52,422 restricted stock units and performance-based restricted stock units during the plan period, subject to certain vesting conditions. Net shares are net of tax withholding.&lt;/span&gt;</ecd:MtrlTermsOfTrdArrTextBlock>
    <ecd:TrdArrIndName contextRef="c-369" id="f-1122">Jacqueline Canney</ecd:TrdArrIndName>
    <ecd:TrdArrIndTitle contextRef="c-369" id="f-1124">Chief People and AI Enablement Officer</ecd:TrdArrIndTitle>
    <ecd:Rule10b51ArrAdoptedFlag contextRef="c-369" id="f-1125">true</ecd:Rule10b51ArrAdoptedFlag>
    <ecd:TrdArrAdoptionDate contextRef="c-369" id="f-1126">May 29, 2026</ecd:TrdArrAdoptionDate>
    <ecd:TrdArrExpirationDate contextRef="c-369" id="f-1127">May 19, 2027</ecd:TrdArrExpirationDate>
