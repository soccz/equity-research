  <ifrs-full:InterestExpenseOnLeaseLiabilities contextRef="PFY2023dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="-3">20652049000</ifrs-full:InterestExpenseOnLeaseLiabilities>
  <ifrs-full:InterestExpenseOnLeaseLiabilities contextRef="CFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="-3">28988709000</ifrs-full:InterestExpenseOnLeaseLiabilities>
  <ifrs-full:DescriptionOfNatureAndPurposeOfReservesWithinEquity contextRef="PFY2023dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_dart_ReportedAmountMember" xml:lang="ko">회사는 대한민국에서 제정되어 시행 중인 상법의 규정에 따라, 자본금의 50%에 달할 때까지 매 결산기마다 현금에 의한 이익배당금의 10% 이상을 이익준비금으로 적립하고 있습니다. 동 이익준비금은 현금으로 배당할 수 없으나 자본전입 또는 결손보전이 가능하며, 자본준비금과 이익준비금의 총액이 자본금의 1.5배를 초과하는 경우, 주주총회의 결의에 따라 그 초과한 금액 범위에서 자본준비금과 이익준비금을 감액할 수 있습니다.</ifrs-full:DescriptionOfNatureAndPurposeOfReservesWithinEquity>
  <dart:VoluntaryReserves contextRef="PFY2023eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_dart_ReportedAmountMember" unitRef="KRW" decimals="-3">13909234000</dart:VoluntaryReserves>
  <ifrs-full:StatutoryReserve contextRef="PFY2023eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_dart_ReportedAmountMember" unitRef="KRW" decimals="-3">8240670000</ifrs-full:StatutoryReserve>
  <ifrs-full:DescriptionOfNatureAndPurposeOfReservesWithinEquity contextRef="CFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_dart_ReportedAmountMember" xml:lang="ko">회사는 대한민국에서 제정되어 시행 중인 상법의 규정에 따라, 자본금의 50%에 달할 때까지 매 결산기마다 현금에 의한 이익배당금의 10% 이상을 이익준비금으로 적립하고 있습니다. 동 이익준비금은 현금으로 배당할 수 없으나 자본전입 또는 결손보전이 가능하며, 자본준비금과 이익준비금의 총액이 자본금의 1.5배를 초과하는 경우, 주주총회의 결의에 따라 그 초과한 금액 범위에서 자본준비금과 이익준비금을 감액할 수 있습니다.</ifrs-full:DescriptionOfNatureAndPurposeOfReservesWithinEquity>
