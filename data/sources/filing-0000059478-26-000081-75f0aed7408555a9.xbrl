    <ecd:TrdArrIndTitle contextRef="c-407" id="f-869">senior vice president, finance, and chief accounting officer</ecd:TrdArrIndTitle>
    <ecd:Rule10b51ArrAdoptedFlag contextRef="c-407" id="f-870">true</ecd:Rule10b51ArrAdoptedFlag>
    <ecd:TrdArrSecuritiesAggAvailAmt contextRef="c-408" decimals="0" id="f-871" unitRef="shares">2000</ecd:TrdArrSecuritiesAggAvailAmt>
