  <ifrs-full:PercentageOfReasonablyPossibleDecreaseInUnobservableInputAssets contextRef="PFY2024eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_FinancialAssetsMeasuredAtFairValueThroughOtherComprehensiveIncomeCategoryMember_ifrs-full_UnobservableInputsAxis_ifrs-full_DiscountRateMeasurementInputMember" unitRef="PURE" decimals="INF">0.01</ifrs-full:PercentageOfReasonablyPossibleDecreaseInUnobservableInputAssets>
  <ifrs-full:IncreaseInFairValueMeasurementDueToChangeInMultipleUnobservableInputsToReflectReasonablyPossibleAlternativeAssumptionsRecognisedInProfitOrLossBeforeTaxAssets contextRef="PFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_FinancialAssetsMeasuredAtFairValueThroughOtherComprehensiveIncomeCategoryMember_ifrs-full_UnobservableInputsAxis_ifrs-full_DiscountRateMeasurementInputMember" unitRef="KRW" decimals="-6">0</ifrs-full:IncreaseInFairValueMeasurementDueToChangeInMultipleUnobservableInputsToReflectReasonablyPossibleAlternativeAssumptionsRecognisedInProfitOrLossBeforeTaxAssets>
  <ifrs-full:DecreaseInFairValueMeasurementDueToChangeInMultipleUnobservableInputsToReflectReasonablyPossibleAlternativeAssumptionsRecognisedInProfitOrLossBeforeTaxAssets contextRef="PFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_FinancialAssetsMeasuredAtFairValueThroughOtherComprehensiveIncomeCategoryMember_ifrs-full_UnobservableInputsAxis_ifrs-full_DiscountRateMeasurementInputMember" unitRef="KRW" decimals="-6">0</ifrs-full:DecreaseInFairValueMeasurementDueToChangeInMultipleUnobservableInputsToReflectReasonablyPossibleAlternativeAssumptionsRecognisedInProfitOrLossBeforeTaxAssets>
