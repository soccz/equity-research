  <ifrs-full:PercentageOfReasonablyPossibleDecreaseInUnobservableInputAssets contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_FinancialAssetsMeasuredAtFairValueThroughOtherComprehensiveIncomeCategoryMember_ifrs-full_UnobservableInputsAxis_ifrs-full_DiscountRateMeasurementInputMember" unitRef="PURE" decimals="INF">0.01</ifrs-full:PercentageOfReasonablyPossibleDecreaseInUnobservableInputAssets>
