  <entity00258801:ChangesInCashAndCashEquivalentsOfChangesInFinancialPositionResultingFromDisposedDiscontinuedOperationsLineItemsOfChangesInFinancialPositionResultingFromDisposedDiscontinuedOperationsTableOfItems contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_ContinuingAndDiscontinuedOperationsAxis_ifrs-full_DiscontinuedOperationsMember" unitRef="KRW" decimals="-3">-470388459000</entity00258801:ChangesInCashAndCashEquivalentsOfChangesInFinancialPositionResultingFromDisposedDiscontinuedOperationsLineItemsOfChangesInFinancialPositionResultingFromDisposedDiscontinuedOperationsTableOfItems>
