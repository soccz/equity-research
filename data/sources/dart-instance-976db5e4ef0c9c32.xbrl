  <entity00126186:CommitmentsAmountUSDOfDisclosureOfCommitmentsLineItemsOfDisclosureOfCommitmentsTableOfItems contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_dart_TypesOfCommitmentsAxis_entity00126186_ImportLetterOfCreditMemberOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember_ifrs-full_CounterpartiesAxis_entity00126186_ShinhanBankOfCounterpartiesMemberOfDisclosureOfCommitmentsTableOfMember" unitRef="USD" decimals="0">27000000</entity00126186:CommitmentsAmountUSDOfDisclosureOfCommitmentsLineItemsOfDisclosureOfCommitmentsTableOfItems>
