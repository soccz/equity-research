  <ifrs-full:ProvisionUsedOtherProvisions contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_ClassesOfProvisionsAxis_ifrs-full_ProvisionForDecommissioningRestorationAndRehabilitationCostsMember" unitRef="KRW" decimals="-3">0</ifrs-full:ProvisionUsedOtherProvisions>
