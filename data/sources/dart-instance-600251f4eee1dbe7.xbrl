  <ifrs-full:InvestmentProperty contextRef="PFY2024eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_CarryingAmountAccumulatedDepreciationAmortisationAndImpairmentAndGrossCarryingAmountAxis_ifrs-full_AccumulatedDepreciationAndAmortisationMember" unitRef="KRW" decimals="-3">-5200064000</ifrs-full:InvestmentProperty>
