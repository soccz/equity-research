  <entity00258801:SpecifiedMoneyTrustsPledgedAsCollateralForLiabilitiesOrContingentLiabilitiesOfFinancialAssetsPledgedAsCollateralForLiabilitiesOrContingentLiabilitiesOfDisclosureAboutAssetsPledgedAsCollateralTableOfItems contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_NameOfSecuredCreditorAxis_entity00258801_HanaBankMemberOfNameOfSecuredCreditorMemberOfDisclosureAboutAssetsPledgedAsCollateralTableOfMember" unitRef="KRW" decimals="-3">2000000000</entity00258801:SpecifiedMoneyTrustsPledgedAsCollateralForLiabilitiesOrContingentLiabilitiesOfFinancialAssetsPledgedAsCollateralForLiabilitiesOrContingentLiabilitiesOfDisclosureAboutAssetsPledgedAsCollateralTableOfItems>
