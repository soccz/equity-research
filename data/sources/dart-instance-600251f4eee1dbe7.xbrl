  <ifrs-full:FinancialAssetsAtFairValue contextRef="PFY2024eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember" unitRef="KRW" decimals="-3">2217402115000</ifrs-full:FinancialAssetsAtFairValue>
