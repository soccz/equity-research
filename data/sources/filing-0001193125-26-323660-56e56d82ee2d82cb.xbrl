        <link:footnote id="FNT_229efe36-4d3d-439b-927e-9c7304734338" xlink:label="FNT_229efe36-4d3d-439b-927e-9c7304734338" xlink:role="http://www.xbrl.org/2003/role/footnote" xlink:type="resource" xml:lang="en-US"><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-style:italic;font-kerning:none;min-width:fit-content;">In fiscal year 2026, state and local income taxes in California, Illinois, Minnesota, New Jersey, New York, and New York City made up the majority (greater than 50%) of the tax effect in this category.</xhtml:span></link:footnote>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_848fa28f-54b0-4ceb-a52d-e6dc512916c6"
          xlink:to="FNT_229efe36-4d3d-439b-927e-9c7304734338"
          xlink:type="arc"/>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_64e5d6b9-ab81-47fc-a80a-10851bae073e"
          xlink:to="FNT_229efe36-4d3d-439b-927e-9c7304734338"
          xlink:type="arc"/>
        <link:loc
          xlink:href="#F_8f8bcaa1-ff26-45c2-b1ea-e69ec58611d6"
          xlink:label="F_8f8bcaa1-ff26-45c2-b1ea-e69ec58611d6"
          xlink:type="locator"/>
        <link:loc
          xlink:href="#F_5ebf8cc5-9ee7-44d4-b6f3-bf32f4483521"
          xlink:label="F_5ebf8cc5-9ee7-44d4-b6f3-bf32f4483521"
          xlink:type="locator"/>
        <link:footnote id="FNT_718d6f5b-89af-4765-8db7-0b31cc243a6f" xlink:label="FNT_718d6f5b-89af-4765-8db7-0b31cc243a6f" xlink:role="http://www.xbrl.org/2003/role/footnote" xlink:type="resource" xml:lang="en-US"><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-style:italic;font-kerning:none;min-width:fit-content;">Under ASU 2023-09, Foreign tax effects include foreign withholding taxes while the related foreign tax credits are included in the Tax credits category. Prior to adoption of ASU 2023-09, foreign withholding taxes were presented net of foreign tax credits.</xhtml:span></link:footnote>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_8f8bcaa1-ff26-45c2-b1ea-e69ec58611d6"
          xlink:to="FNT_718d6f5b-89af-4765-8db7-0b31cc243a6f"
          xlink:type="arc"/>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_5ebf8cc5-9ee7-44d4-b6f3-bf32f4483521"
          xlink:to="FNT_718d6f5b-89af-4765-8db7-0b31cc243a6f"
          xlink:type="arc"/>
        <link:loc
          xlink:href="#F_a2ea09d3-5cea-4630-b3c0-63f8b15b8b5a"
          xlink:label="F_a2ea09d3-5cea-4630-b3c0-63f8b15b8b5a"
          xlink:type="locator"/>
        <link:loc
          xlink:href="#F_0845940e-2a38-4239-a84d-085e6c567c28"
          xlink:label="F_0845940e-2a38-4239-a84d-085e6c567c28"
          xlink:type="locator"/>
        <link:footnote id="FNT_978b8ce2-0cd2-4f25-b881-5f9f5c911681" xlink:label="FNT_978b8ce2-0cd2-4f25-b881-5f9f5c911681" xlink:role="http://www.xbrl.org/2003/role/footnote" xlink:type="resource" xml:lang="en-US"><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-style:italic;font-kerning:none;min-width:fit-content;">Under ASU 2023-09, we elected to present the effect of cross-border tax laws gross and present the foreign tax credits related to GILTI within the Tax credits category.</xhtml:span></link:footnote>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_a2ea09d3-5cea-4630-b3c0-63f8b15b8b5a"
          xlink:to="FNT_978b8ce2-0cd2-4f25-b881-5f9f5c911681"
          xlink:type="arc"/>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_0845940e-2a38-4239-a84d-085e6c567c28"
          xlink:to="FNT_978b8ce2-0cd2-4f25-b881-5f9f5c911681"
          xlink:type="arc"/>
        <link:loc
          xlink:href="#F_114ec728-27d3-4db7-a8a3-cba6eb1d55cc"
          xlink:label="F_114ec728-27d3-4db7-a8a3-cba6eb1d55cc"
          xlink:type="locator"/>
        <link:loc
          xlink:href="#F_64eee10d-5ae3-48d9-a4fb-ef1102e930e9"
          xlink:label="F_64eee10d-5ae3-48d9-a4fb-ef1102e930e9"
          xlink:type="locator"/>
        <link:footnote id="FNT_1c5065f4-4166-4631-8235-f49e10aadcc7" xlink:label="FNT_1c5065f4-4166-4631-8235-f49e10aadcc7" xlink:role="http://www.xbrl.org/2003/role/footnote" xlink:type="resource" xml:lang="en-US"><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-style:italic;font-kerning:none;min-width:fit-content;">Includes changes in unrecognized tax benefits on an aggregated basis for all jurisdictions, including interest and penalties.</xhtml:span></link:footnote>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_114ec728-27d3-4db7-a8a3-cba6eb1d55cc"
          xlink:to="FNT_1c5065f4-4166-4631-8235-f49e10aadcc7"
          xlink:type="arc"/>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
