         &lt;td style="padding-top:0in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;"&gt;&lt;p style="font-size:7.5pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"&gt;&lt;span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-family:Arial;font-kerning:none;min-width:fit-content;"&gt;Designated as Hedging Instruments&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
