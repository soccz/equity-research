        <link:footnote id="FNT_d29a3f1c-fd47-4a58-b933-c83ad7e59ccc" xlink:label="FNT_d29a3f1c-fd47-4a58-b933-c83ad7e59ccc" xlink:role="http://www.xbrl.org/2003/role/footnote" xlink:type="resource" xml:lang="en-US"><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-style:italic;font-kerning:none;min-width:fit-content;">Includes </xhtml:span><xhtml:span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-style:italic;font-kerning:none;min-width:fit-content;">1</xhtml:span><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-style:italic;font-kerning:none;min-width:fit-content;"> million of PSUs granted at target and performance adjustments above target levels for each of the fiscal years 2026, 2025, and 2024.</xhtml:span></link:footnote>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_6864bad0-1335-4d89-9675-666bf613c476"
