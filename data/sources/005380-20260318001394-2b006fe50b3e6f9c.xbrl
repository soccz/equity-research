  <entity00164742:IssueDateOfHybridBondsOfDetailsOfHybridBondsLineItemsOfDetailsOfHybridBondTableOfItems contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_SignificantInvestmentsInSubsidiariesAxis_entity00164742_HybridBonds2MemberOfHyundaiCardCoLtdMemberOfDetailsOfHybridBondTableOfMember" xml:lang="ko">2024-01-31</entity00164742:IssueDateOfHybridBondsOfDetailsOfHybridBondsLineItemsOfDetailsOfHybridBondTableOfItems>
