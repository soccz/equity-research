  <ifrs-full:FinancialAssetsAtFairValue contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_LevelsOfFairValueHierarchyAxis_ifrs-full_Level2OfFairValueHierarchyMember" unitRef="KRW" decimals="-6">4791458000000</ifrs-full:FinancialAssetsAtFairValue>
