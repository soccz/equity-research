  <ifrs-full:IncomeFromContinuingOperationsAttributableToOwnersOfParent contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="-6">12845953000000</ifrs-full:IncomeFromContinuingOperationsAttributableToOwnersOfParent>
