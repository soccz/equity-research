"padding:0 1pt"&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-align:right"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:130%"&gt;29&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Johnson Text',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;MedTech Segment Orthopaedics franchise&lt;/span&gt;&lt;span style="color:#000000;font-family:'Johnson Text',sans-serif;font-size:5.85pt;font-weight:400;line-height:120%;position:relative;top:-3.15pt;vertical-align:baseline"&gt;(3)&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-align:right"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:130%"&gt;17&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-align:right"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:130%"&gt;50&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-align:right"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:130%"&gt;24&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"&gt;&lt;/td&gt;&lt;td colspan="3" styl