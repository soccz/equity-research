  <ifrs-full:DilutedEarningsLossPerShare contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember" unitRef="KRWEPS" decimals="INF">16062</ifrs-full:DilutedEarningsLossPerShare>
  <ifrs-full:DilutedEarningsLossPerShare contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_ClassesOfShareCapitalAxis_ifrs-full_OrdinarySharesMember" unitRef="KRWEPS" decimals="INF">16062</ifrs-full:DilutedEarningsLossPerShare>
