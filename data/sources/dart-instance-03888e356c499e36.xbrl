  <ifrs-full:DilutedEarningsLossPerShare contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRWEPS" decimals="INF">17768</ifrs-full:DilutedEarningsLossPerShare>
