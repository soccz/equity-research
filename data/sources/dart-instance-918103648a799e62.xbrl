  <dart:DecreaseInProfitDueToIncreaseInMarketRiskVariable contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfRisksAxis_ifrs-full_InterestRateRiskMember" unitRef="KRW" decimals="-3">5277721000</dart:DecreaseInProfitDueToIncreaseInMarketRiskVariable>
