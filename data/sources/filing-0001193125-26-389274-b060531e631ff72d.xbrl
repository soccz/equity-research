        &lt;/tr&gt;
        &lt;tr style="height:7pt;background-color:#ffffff;word-break:break-word;white-space:pre-wrap;text-align:left;"&gt;
         &lt;td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"&gt;&lt;p style="tab-size:26.66px;font-size:7.5pt;margin-top:0;font-family:'Calibri',sans-serif;margin-bottom:0;text-align:left;"&gt;&lt;span style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;"&gt;&#160;&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
