  <ifrs-full:DescriptionOfExpectedVolatilityShareOptionsGranted contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfSharebasedPaymentArrangementsAxis_entity00164779_One2NdMemberOfStockSettlementBasedShareBasedPaymentArrangementMemberOfDisclosureOfIndirectMeasurementOfFairValueOfGoodsOrServicesReceivedShareOptionsGrantedDuringPeriodTableOfMember_ifrs-full_ValuationTechniquesUsedInFairValueMeasurementAxis_dart_BinomialModelMember" unitRef="PURE" decimals="INF">0.3422</ifrs-full:DescriptionOfExpectedVolatilityShareOptionsGranted>
