  <dart:RestrictedFinancialAssets contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_RestrictedFinancialAssetAxis_entity00145109_LongTermInvestmentAssetsAndInvestmentsInAssociatesMemberOfRestrictedFinancialAssetsMemberOfDetailedRestrictedFinancialAssetsTableOfMember" unitRef="KRW" decimals="-3">57455969000</dart:RestrictedFinancialAssets>
  <dart:ExplanationOfRestrictedFinancialAssets contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_RestrictedFinancialAssetAxis_entity00145109_LongTermInvestmentAssetsAndInvestmentsInAssociatesMemberOfRestrictedFinancialAssetsMemberOfDetailedRestrictedFinancialAssetsTableOfMember" xml:lang="ko">연결회사가 보유한 장기투자자산 및 관계기업투자주식 중 일부 금융자산(공정가치 : 57,455,969천원)은 처분제한 조건이 있습니다.</dart:ExplanationOfRestrictedFinancialAssets>
  <entity00145109:AmountOfCollateralOfDisclosureOfDetailsOfAssetsPledgedAsCollateralLineItemsOfDisclosureOfDetailsOfAssetsPledgedAsCollateralTableOfItems contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_NameOfSecuredCreditorAxis_entity00145109_BondPurchaserMemberOfNameOfSecuredCreditorMemberOfDisclosureOfDetailsOfAssetsPledgedAsCollateralTableOfMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_PropertyPlantAndEquipmentMember" unitRef="KRW" decimals="-3">25729000000</entity00145109:AmountOfCollateralOfDisclosureOfDetailsOfAssetsPledgedAsCollateralLineItemsOfDisclosureOfDetailsOfAssetsPledgedAsCollateralTableOfItems>
  <entity00145109:DescriptionOfAssetsPledgedAsCollateralOfDisclosureOfDetailsOfAssetsPledgedAsCollateralLineItemsOfDisclosureOfDetailsOfAssetsPledgedAsCollateralTableOfItems contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_NameOfSecuredCreditorAxis_entity00145109_BondPurchaserMemberOfNameOfSecuredCreditorMemberOfDisclosureOfDetailsOfAssetsPledgedAsCollateralTableOfMember_ifrs-full_ClassesOfAssetsAxis_ifrs-full_PropertyPlantAndEquipmentMember" xml:lang="ko">연결회사가 발행한 신주인수권부사채와 관련하여 당기말 현재 보유중인 유형자산 중 일부를 사채인수자에게 담보로 제공하고 있으며, 담보설정금액은 25,729,000천원입니다.</entity00145109:DescriptionOfAssetsPledgedAsCollateralOfDisclosureOfDetailsOfAssetsPledgedAsCollateralLineItemsOfDisclosureOfDetailsOfAssetsPledgedAsCollateralTableOfItems>
  <entity00145109:CapitalCommitmentsUSDOfDisclosureOfCommitmentsLineItemsOfDisclosureOfCommitmentsTableOfItems contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00145109_CapitalCommitmentsMemberOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" unitRef="USD" decimals="-3">3050000</entity00145109:CapitalCommitmentsUSDOfDisclosureOfCommitmentsLineItemsOfDisclosureOfCommitmentsTableOfItems>
  <ifrs-full:CapitalCommitments contextRef="CFY2025eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00145109_CapitalCommitmentsMemberOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" unitRef="KRW" decimals="-3">1876250000</ifrs-full:CapitalCommitments>
  <dart:DescriptionOfCommitments contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00145109_CapitalCommitmentsMemberOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">연결회사는 유안타 K-바이오백신 블록버스터 사모투자합자회사 및 5AM Ventures VII 펀드에 대하여 약정에 따른 추가 출자의무가 존재합니다. 연결회사는 추후 캐피탈콜(Capital Call) 방식으로 각 회사 및 펀드에 대하여 잔여 약정금액인 1,876,250천원 및 USD 305만을 출자할 예정입니다.</dart:DescriptionOfCommitments>
  <dart:DescriptionOfCommitments contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00145109_AgreementBetweenShareholdersRelatedToInvestmentsInSubsidiaries2MemberOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">지배기업은 종속기업투자주식으로 보유하고 있는 ㈜유한코스메틱(구, ㈜코스온)의 지분과 관련하여 투자자에게 동반매도참여권(Tag along right) 조항이 포함된 주주간 계약을 체결하였으며, 상기 조항에 따라 일정 조건하에서 주식 처분이 제한되어 있습니다.</dart:DescriptionOfCommitments>
  <dart:DescriptionOfCommitments contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00145109_AgreementBetweenShareholdersRelatedToLongTermInvestmentsAndInvestmentsInAssociatesMemberOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">연결회사는 장기투자자산 및 관계기업투자주식으로 보유하고 있는 (주)아임뉴런, (주)프로젠, (주)지아이롱제비티(구, (주)지아이바이옴), (주)휴이노, 메리츠엔에이치헬스케어1호, (주)메디오젠, (주)네오딘바이오벳, 제노스바이오(주)(구, 주노랩(주)), 아밀로이드솔루션(주), (주)노보메디슨, (주)에임드바이오, (주)테라베스트, (주)제이인츠바이오, 메디라마(주), (주)온코마스터, (주)에이인비, (주)사이러스테라퓨틱스, 제노스코, (주)휴이노에임, (주)킴셀앤진 및 (주)코랩의 지분과 관련하여 공동매도권(Tag along right) 조항이 포함된 주주간계약을 체결하였으며, 상기 조항에 따라 다른 주주가 매도를 반대하는 경우는 공동매도권자가 매도하고자 하는 주식을 매도할 수 없습니다.</dart:DescriptionOfCommitments>
  <dart:DescriptionOfCommitments contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00145109_AgreementBetweenShareholdersRelatedToInvestmentsInSubsidiaries1MemberOfTypesOfCommitmentsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">지배기업은 종속기업투자주식으로 보유하고 있는 ㈜와이즈메디의 지분증권 취득시 공동매도권(Tag along right) 조항이 포함된 주주간 계약을 함께 체결하였으며, 상기 조항에 따라 제 3 매수인이 공동매도권자가 매도하고자 하는 주식 전부를 당초 제안한 조건이상으로 매수하지 않는 한 주식을 매도할 수 없습니다.</dart:DescriptionOfCommitments>
  <dart:ProvisionOfGuaranteesByToEntityOfNonPF contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfPaymentGuaranteesAxis_entity00145109_PriceAgreementForLeclazaTabletsMemberOfReceivedPaymentGuaranteeMemberOfDisclosureOfContingentLiabilitiesForGuaranteesNonPFTableOfMember" unitRef="KRW" decimals="-3">98685000000</dart:ProvisionOfGuaranteesByToEntityOfNonPF>
  <dart:RemarksCommentsAboutGuarantee contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfPaymentGuaranteesAxis_entity00145109_PriceAgreementForLeclazaTabletsMemberOfReceivedPaymentGuaranteeMemberOfDisclosureOfContingentLiabilitiesForGuaranteesNonPFTableOfMember" xml:lang="ko">연결회사는 2021년 중 렉라자정 약가 합의와 관련하여 국민건강보험공단과 위험분담계약을 체결하였으며, 당기말 현재 국민건강보험공단에 지급될 약가 환급액 및 지연손해금에 대하여 신한은행으로부터 98,685,000천원의 지급보증을 제공받고 있습니다.</dart:RemarksCommentsAboutGuarantee>
  <dart:GuaranteeProvider contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfPaymentGuaranteesAxis_entity00145109_PriceAgreementForLeclazaTabletsMemberOfReceivedPaymentGuaranteeMemberOfDisclosureOfContingentLiabilitiesForGuaranteesNonPFTableOfMember" xml:lang="ko">신한은행</dart:GuaranteeProvider>
