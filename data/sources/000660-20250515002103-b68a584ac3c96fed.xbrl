  <ifrs-full:FinancialLiabilities contextRef="CFY2025eFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfRisksAxis_ifrs-full_InterestRateRiskMember_ifrs-full_TypesOfInterestRatesAxis_ifrs-full_FloatingInterestRateMember_ifrs-full_ClassesOfFinancialInstrumentsAxis_dart_BorrowingsMember_ifrs-full_HedgingInstrumentsAxis_entity00164779_CurrencyInterestSwapContractMemberOfHedgingInstrumentsMemberOfDisclosureOfFinancialInstrumentsByTypeOfInterestRateTableOfMember" unitRef="KRW" decimals="-6">320797000000</ifrs-full:FinancialLiabilities>
  <ifrs-full:FinancialLiabilities contextRef="CFY2025eFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfRisksAxis_ifrs-full_InterestRateRiskMember_ifrs-full_TypesOfInterestRatesAxis_ifrs-full_FloatingInterestRateMember_ifrs-full_ClassesOfFinancialInstrumentsAxis_dart_BorrowingsMember_ifrs-full_HedgingInstrumentsAxis_ifrs-full_InterestRateSwapContractMember" unitRef="KRW" decimals="-6">443000000000</ifrs-full:FinancialLiabilities>
  <ifrs-full:DescriptionOfObjectivesPoliciesAndProcessesForManagingRisk contextRef="CFY2025dFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfRisksAxis_ifrs-full_InterestRateRiskMember_ifrs-full_TypesOfInterestRatesAxis_ifrs-full_FloatingInterestRateMember_ifrs-full_ClassesOfFinancialInstrumentsAxis_dart_BorrowingsMember" xml:lang="ko">회사는 현금흐름 이자율위험을 변동이자수취/고정이자지급 스왑을 이용하여 관리하고 있습니다. 이러한 이자율 스왑은 변동이자부 차입금을 고정이자부 차입금으로 바꾸는 경제적 효과가 있습니다. 일반적으로, 회사는 변동이자율로 차입금을 발생시킨 후 고정이자율로 스왑을 하게 됩니다. 스왑계약에 따라 회사는 거래상대방과 특정기간(주로 분기)마다, 합의된 원금에 따라 계산된 고정이자와 변동이자의 차이를 결제하게 됩니다.</ifrs-full:DescriptionOfObjectivesPoliciesAndProcessesForManagingRisk>
  <dart:DecreaseInProfitDueToIncreaseInMarketRiskVariable contextRef="CFY2025dFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_TypesOfRisksAxis_ifrs-full_InterestRateRiskMember" unitRef="KRW" decimals="-6">-15968000000</dart:DecreaseInProfitDueToIncreaseInMarketRiskVariable>
