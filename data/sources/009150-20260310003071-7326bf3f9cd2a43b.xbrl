  <ifrs-full:RevenueFromRoyalties contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_dart_TypesOfCommitmentsAxis_entity00126371_TechnologyProvisionContractMemberOfTypesOfCommitmentsMemberOfDisclosureForTechnologyProvisionAgreementTableOfMember" unitRef="KRW" decimals="-3">141246643000</ifrs-full:RevenueFromRoyalties>
  <dart:DescriptionOfCommitments contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_dart_TypesOfCommitmentsAxis_entity00126371_TechnologyProvisionContractMemberOfTypesOfCommitmentsMemberOfDisclosureForTechnologyProvisionAgreementTableOfMember" xml:lang="ko">회사는 Tianjin Samsung Electro-Mechanics Co., Ltd.외 3개의 해외현지법인과 기술제공계약을 체결하고 있습니다. 계약상 내용에 따라 해외현지법인의 관련 매출의 4%를 로열티로 수령하고 있으며, 당기 중 회사가 해외현지법인으로부터 인식한 로열티 매출은 141,246,643천원(전기:128,822,980천원)입니다.</dart:DescriptionOfCommitments>
  <dart:NameOfTheInstitutionMakingTheCommitments contextRef="PFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_dart_TypesOfCommitmentsAxis_entity00126371_TechnologyProvisionContractMemberOfTypesOfCommitmentsMemberOfDisclosureForTechnologyProvisionAgreementTableOfMember" xml:lang="ko">Tianjin Samsung Electro-Mechanics Co., Ltd.외 3개의 해외현지법인</dart:NameOfTheInstitutionMakingTheCommitments>
