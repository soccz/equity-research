  <ifrs-full:DescriptionOfLineItemInStatementOfFinancialPositionThatIncludesHedgedItem contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" xml:lang="ko">일부 차입금의 이자율 및 환율 변동에 따른 위험회피를 위하여 통화스왑 계약을 체결하고 있습니다.</ifrs-full:DescriptionOfLineItemInStatementOfFinancialPositionThatIncludesHedgedItem>
  <ifrs-full:DescriptionOfLineItemInStatementOfFinancialPositionThatIncludesHedgedItem contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_HedgedItemsAxis_ifrs-full_CurrencySwapContractMember" xml:lang="ko">차입금</ifrs-full:DescriptionOfLineItemInStatementOfFinancialPositionThatIncludesHedgedItem>
  <ifrs-full:DescriptionOfLineItemInStatementOfFinancialPositionThatIncludesHedgedItem contextRef="CFY2026dHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_TypesOfHedgesAxis_ifrs-full_CashFlowHedgesMember_ifrs-full_HedgedItemsAxis_ifrs-full_InterestRateSwapContractMember" xml:lang="ko">차입금</ifrs-full:DescriptionOfLineItemInStatementOfFinancialPositionThatIncludesHedgedItem>
