  <ifrs-full:ProportionOfOwnershipInterestsHeldByNoncontrollingInterests contextRef="CFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_SignificantInvestmentsInSubsidiariesAxis_entity00401731_AlphonsoHellasSAMemberOfEuropeMemberOfDisclosureOfSignificantInvestmentsInSubsidiariesTableOfMember" unitRef="PURE" decimals="INF">0.343</ifrs-full:ProportionOfOwnershipInterestsHeldByNoncontrollingInterests>
