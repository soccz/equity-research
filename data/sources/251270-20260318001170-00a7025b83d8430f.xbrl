  <entity00904672:AcquisitionPathOfAcquisitionAndRetentionVirtualAssetsOfAcquisitionAndRetentionVirtualAssetsTableOfItems contextRef="CFY2025dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_entity00904672_NameOfVirtualAssetsOfAcquisitionAndRetentionVirtualAssetsOfAxis_entity00904672_OasOfVirtualAssetsOfAcquisitionAndRetentionVirtualAssetsTableOfMember" xml:lang="ko">용역제공</entity00904672:AcquisitionPathOfAcquisitionAndRetentionVirtualAssetsOfAcquisitionAndRetentionVirtualAssetsTableOfItems>
