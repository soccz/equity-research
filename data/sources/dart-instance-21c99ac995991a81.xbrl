  <dart:DecreaseInProfitDueToIncreaseInMarketRiskVariable contextRef="CFY2024dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_TypesOfRisksAxis_ifrs-full_CurrencyRiskMember_ifrs-full_CurrencyInWhichInformationIsDisplayedAxis_dart_CNYMember" unitRef="KRW" decimals="-6">-8724000000</dart:DecreaseInProfitDueToIncreaseInMarketRiskVariable>
