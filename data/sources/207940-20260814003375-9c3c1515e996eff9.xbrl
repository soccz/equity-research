  <entity00877059:CommitmentsAmountForeignCurrencyUsdOfDisclosureOfContingentLiabilitiesForGuaranteesNonPfLineItemsOfDisclosureOfContingentLiabilitiesForGuaranteesNonPFTableOfItems contextRef="CFY2026eHYA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfPaymentGuaranteesAxis_dart_ReceivedPaymentGuaranteeMember_ifrs-full_CounterpartiesAxis_entity00877059_JPMorganPaymentGuaranteeMemberOfCounterpartiesDomainOfDisclosureOfContingentLiabilitiesForGuaranteesNonPFTableOfMember" unitRef="USD" decimals="2">24297843.62</entity00877059:CommitmentsAmountForeignCurrencyUsdOfDisclosureOfContingentLiabilitiesForGuaranteesNonPfLineItemsOfDisclosureOfContingentLiabilitiesForGuaranteesNonPFTableOfItems>
