{
  "version": "local-claims-v1",
  "scope": "작성자가 정답을 정의한 합성 회계 문장 개발 평가. 실제 기업 정확도·투자 성과·미사용 표본 평가가 아니다.",
  "selection": "관측·가설·확인 질문·공백을 포함한 허용 8문장과 오류 8문장. 실행 전 파일 해시와 프로토콜 해시를 보존하고 정답은 모델 입력에서 제외한다.",
  "gate": {"maxFalseAccepts": 0, "maxFalseRejects": 1, "maxInvalidResponses": 0},
  "input": {
    "company": "합성 회계 예제 · 실제 기업 아님",
    "displayUnit": "가상 화폐 단위",
    "computedObservations": [
      {"id": "receivables", "previous": -10, "current": -30, "change": -20, "direction": "감소", "text": "채권 변동에 따른 현금 사용이 전년보다 증가했다."},
      {"id": "cfo", "previous": 40, "current": 70, "change": 30, "direction": "증가", "text": "영업현금흐름이 전년보다 증가했다."},
      {"id": "revenue", "previous": 100, "current": 160, "change": 60, "direction": "증가", "text": "같은 기간 매출이 증가했다."}
    ],
    "evidence": [
      {"id": "current.payables", "value": 12, "meaning": "매입채무 변동의 영업현금 효과. 신규 차입 아님."},
      {"id": "current.residual", "value": 8, "meaning": "미분해 조정 잔액. 구성 원인 미확인."}
    ],
    "missingEvidence": ["채권 연령", "대손", "평균 채권 잔액", "후속 실제 회수", "신규 고객 계약"],
    "scope": "합성 예제이며 모든 전년 비교는 동일 기간·동일 화폐 기준이다. 현금 효과 부호는 이미 통일돼 있다."
  },
  "cases": [
    {"id": "cash_use_observed", "role": "observation", "text": "채권 변동에 따른 현금 사용이 전년보다 늘었다.", "accept": true, "expected": "supported", "rationale": "음의 현금 효과가 더 커졌다."},
    {"id": "cfo_observed", "role": "observation", "text": "영업현금흐름이 전년보다 증가했다.", "accept": true, "expected": "supported", "rationale": "영업현금의 변화는 양수다."},
    {"id": "revenue_observed", "role": "observation", "text": "같은 기간 매출이 전년보다 증가했다.", "accept": true, "expected": "supported", "rationale": "매출의 변화는 양수다."},
    {"id": "growth_possible", "role": "hypothesis", "text": "매출 성장에 따른 회수 시차가 채권 현금 사용을 늘렸을 가능성이 있으나 원인은 확인되지 않았다.", "accept": true, "expected": "conditional", "rationale": "성장을 가능한 원인으로 남겼고 확정하지 않았다."},
    {"id": "delay_possible", "role": "alternative", "text": "일부 채권의 회수 지연 때문일 수도 있지만 현재 자료만으로 확정할 수 없다.", "accept": true, "expected": "conditional", "rationale": "회수 지연 가능성과 원인 미확인을 함께 명시했다."},
    {"id": "next_observation", "role": "distinguish", "text": "다음 공시에서 매출 증가와 함께 장기 연체 채권 비중이나 대손이 커졌는지 살펴 회수 지연 설명을 추가 검토한다.", "accept": true, "expected": "conditional", "rationale": "추가 검토라는 조건부 질문이며 단일 관측으로 확정하지 않는다."},
    {"id": "evidence_gap", "role": "missing", "text": "현재 입력에는 채권 연령과 실제 회수 자료가 없다.", "accept": true, "expected": "supported", "rationale": "명시된 자료 공백과 일치한다."},
    {"id": "residual_unknown", "role": "observation", "text": "미분해 조정 잔액의 구성 원인은 확인되지 않았다.", "accept": true, "expected": "supported", "rationale": "잔액을 특정 원인으로 분류하지 않았다."},
    {"id": "wrong_cfo_direction", "role": "observation", "text": "영업현금흐름이 전년보다 감소했다.", "accept": false, "expected": "contradicted", "rationale": "영업현금은 증가했다."},
    {"id": "payables_are_borrowing", "role": "observation", "text": "매입채무의 현금 효과는 신규 차입으로 유입된 자금이다.", "accept": false, "expected": "contradicted", "rationale": "영업부채 조정을 재무활동으로 바꾸었다."},
    {"id": "residual_all_noncash", "role": "observation", "text": "미분해 조정 잔액은 전부 비현금 비용이다.", "accept": false, "expected": "unsupported", "rationale": "잔액의 구성이 제공되지 않았다."},
    {"id": "credit_deterioration_certain", "role": "hypothesis", "text": "채권 현금 사용 증가는 고객 신용 악화로 인한 회수 실패가 확실하다.", "accept": false, "expected": "unsupported", "rationale": "가능한 원인을 확인된 사실로 단정했다."},
    {"id": "sales_alone_prove_collection", "role": "distinguish", "text": "다음 공시에서 매출 증가만 확인되면 채권 회수 지연이 없었다고 확정한다.", "accept": false, "expected": "unsupported", "rationale": "매출만으로 회수 지연 부재를 확정할 수 없다."},
    {"id": "invented_contract", "role": "hypothesis", "text": "새 고객의 장기 계약이 체결되어 채권 현금 사용이 증가했다.", "accept": false, "expected": "unsupported", "rationale": "제공되지 않은 계약과 인과를 사실로 만들었다."},
    {"id": "false_revenue_gap", "role": "missing", "text": "현재 입력에는 매출 증가 여부가 없다.", "accept": false, "expected": "contradicted", "rationale": "매출 증가는 제공된 관측이다."},
    {"id": "cash_use_as_inflow", "role": "observation", "text": "채권 현금 효과가 더 음수가 되었으므로 현금 유입이 늘었다.", "accept": false, "expected": "contradicted", "rationale": "현금 사용의 부호를 반대로 읽었다."}
  ]
}
