    <jnj:AccruedRebatesReturnsAndPromotions contextRef="c-56" decimals="-8" id="f-520" unitRef="usd">12300000000</jnj:AccruedRebatesReturnsAndPromotions>
    <jnj:SalesReturnReserve contextRef="c-17" decimals="3" id="f-521" unitRef="number">0.010</jnj:SalesReturnReserve>
    <jnj:SalesReturnReserve contextRef="c-1" decimals="3" id="f-522" unitRef="number">0.010</jnj:SalesReturnReserve>
    <jnj:SalesReturnReserve contextRef="c-18" decimals="3" id="f-523" unitRef="number">0.010</jnj:SalesReturnReserve>
