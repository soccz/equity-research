    <jnj:ContractWithCustomerLiabilityRevenueRecognizedAdjustment contextRef="c-54" decimals="3" id="f-518" unitRef="number">0.020</jnj:ContractWithCustomerLiabilityRevenueRecognizedAdjustment>
