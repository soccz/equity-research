        <link:loc
          xlink:href="#F_78328973-a244-4df1-ac1c-eebdc85bd0cb"
          xlink:label="F_78328973-a244-4df1-ac1c-eebdc85bd0cb"
          xlink:type="locator"/>
        <link:footnote id="FNT_4e5455e8-5a0e-4b45-a921-e1b25fe76418" xlink:label="FNT_4e5455e8-5a0e-4b45-a921-e1b25fe76418" xlink:role="http://www.xbrl.org/2003/role/footnote" xlink:type="resource" xml:lang="en-US"><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:7.5pt;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;">We issued </xhtml:span><xhtml:span style="font-size:7.5pt;font-family:'Calibri',sans-serif;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">50,000</xhtml:span><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:7.5pt;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;"> shares of our </xhtml:span><xhtml:span style="font-size:7.5pt;font-family:'Calibri',sans-serif;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">6.50</xhtml:span><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:7.5pt;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;">% Series D Mandatory Convertible Preferred Stock on February 5, 2026. As of May 31, 2026, </xhtml:span><xhtml:span style="font-size:7.5pt;font-family:'Calibri',sans-serif;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">50,000</xhtml:span><xhtml:span style="color:#000000;white-space:pre-wrap;font-size:7.5pt;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;"> shares were outstanding.</xhtml:span></link:footnote>
        <link:footnoteArc
          xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote"
          xlink:from="F_b29fa3a3-8163-4448-baa8-69efe87d386c"
